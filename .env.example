# Copy this to .env and fill in your values
# Without these set, the app uses SQLite + local disk (fine for local dev)

# Render PostgreSQL — copy the "External Database URL" from your Render dashboard
DATABASE_URL=postgresql://user:password@host/dbname

# ntfy.sh push notifications — pick any unique topic name (keep it private, treat like a password)
# Install the free ntfy app on your phone and subscribe to this topic to receive motion alerts
NTFY_TOPIC=securecam-yourname-abc123

# Cloudflare R2 — from your R2 bucket settings
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=securecam-recordings
